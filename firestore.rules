rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper function to get the current user's UID
    function uid() {
      return request.auth.uid;
    }

    // --- Users ---
    match /users/{userId} {
      // Anyone authenticated can read user profiles (necessary for chat, item ownership, etc.)
      allow read: if isAuth();
      // Only the user themselves can create or update their own profile
      allow create, update: if isAuth() && userId == uid();
      // Prevent users from deleting their profiles directly if you want admin control, else allow
      allow delete: if false; 
    }

    // --- Items ---
    match /items/{itemId} {
      // Anyone authenticated can view items
      allow read: if isAuth();
      // Any authenticated user can create an item
      allow create: if isAuth();
      // Only the owner can update the item, or it's an update marking a receiver (basic check)
      allow update: if isAuth() && (resource.data.ownerId == uid() || request.resource.data.receiverId == uid() || resource.data.receiverId == uid());
      // Only owner can delete
      allow delete: if isAuth() && resource.data.ownerId == uid();
    }

    // --- Chats ---
    match /chats/{chatId} {
      // Only participants can read or update the chat room metadata
      allow read, update: if isAuth() && (uid() in resource.data.participantIds);
      allow create: if isAuth() && (uid() in request.resource.data.participantIds);
      
      // Nested messages collection
      match /messages/{messageId} {
        // Users can only read messages if they are part of the parent chat room
        allow read: if isAuth() && (uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
        // Only the sender can create a new message
        allow create: if isAuth() && request.resource.data.senderId == uid() && (uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
        allow update: if false; // Messages shouldn't be edited once sent in this basic secure model
        allow delete: if false; // Messages shouldn't be deleted by users
      }
    }

    // --- Reviews ---
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.reviewerId == uid();
      allow update, delete: if false;
    }

    // --- Admin (Feedback, Reports, Archived Requests) ---
    match /feedback/{feedbackId} {
      allow create: if isAuth() && request.resource.data.userId == uid();
      // Only admins should read/update feedback, but we restrict it here to creator or admins if admin role is defined
      allow read: if isAuth() && (resource.data.userId == uid() || get(/databases/$(database)/documents/users/$(uid())).data.role == 'Admin');
      allow update: if isAuth() && get(/databases/$(database)/documents/users/$(uid())).data.role == 'Admin';
    }

    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterId == uid();
      allow read: if isAuth() && (resource.data.reporterId == uid() || get(/databases/$(database)/documents/users/$(uid())).data.role == 'Admin');
      allow update: if isAuth() && get(/databases/$(database)/documents/users/$(uid())).data.role == 'Admin';
    }

    match /archived_requests/{requestId} {
      // Only admins can read/write archived requests
      allow read, write: if isAuth() && get(/databases/$(database)/documents/users/$(uid())).data.role == 'Admin';
    }
  }
}
